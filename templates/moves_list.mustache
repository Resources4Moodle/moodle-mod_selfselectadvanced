{{!
    @template mod_selfselectadvanced/moves_list

    Pending staged moves with per-rule verdicts and joint commit.

    Context variables required for this template:
    * hasrows - whether pending moves exist
    * sesskey - session key

    Example context (json):
    {
        "hasrows": true,
        "rows": [
            {"moveid": 1, "user": "Sam One", "source": "Team A", "target": "Team B",
             "makeleader": false, "allok": true,
             "chips": [{"rule": "L2", "ok": true, "bypassed": false, "reason": "5 of 6 after"}]}
        ],
        "stageurl": "https://example.com/mod/selfselectadvanced/moveedit.php?id=1",
        "actionurl": "https://example.com/mod/selfselectadvanced/moves.php?id=1",
        "cmid": 1,
        "sesskey": "abc",
        "backurl": "https://example.com/back"
    }
}}
<div class="selfselectadvanced-moves">
    <h3>{{#str}} pendingmoves, mod_selfselectadvanced {{/str}}</h3>
    <p class="text-muted">{{#str}} movesintro, mod_selfselectadvanced {{/str}}</p>

    {{#hasrows}}
        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="action" value="commit">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div class="table-responsive">
                <table class="table generaltable">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} select {{/str}}</th>
                            <th scope="col">{{#str}} movestudent, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} movefrom, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} moveto, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} movevalidation, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} actions {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                <td>
                                    <input type="checkbox" name="selected[]" value="{{moveid}}" checked
                                        aria-label="{{#str}} select {{/str}} {{user}}">
                                </td>
                                <td>
                                    {{user}}
                                    {{#makeleader}}
                                        <span class="badge bg-primary">{{#str}} leader, mod_selfselectadvanced {{/str}}</span>
                                    {{/makeleader}}
                                </td>
                                <td>{{source}}</td>
                                <td>{{target}}</td>
                                <td>
                                    {{#chips}}
                                        <span class="badge {{#ok}}bg-success{{/ok}}{{^ok}}{{#bypassed}}bg-warning text-dark{{/bypassed}}{{^bypassed}}bg-danger{{/bypassed}}{{/ok}}"
                                            title="{{reason}}">
                                            {{rule}}{{#bypassed}} {{#str}} movebypassed, mod_selfselectadvanced {{/str}}{{/bypassed}}
                                        </span>
                                        <span class="visually-hidden">{{reason}}</span>
                                    {{/chips}}
                                </td>
                                <td></td>
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
            <button type="submit" class="btn btn-primary">{{#str}} movecommitselected, mod_selfselectadvanced {{/str}}</button>
        </form>
        {{#rows}}
            <form method="post" action="{{actionurl}}" class="d-inline">
                <input type="hidden" name="id" value="{{cmid}}">
                <input type="hidden" name="action" value="cancel">
                <input type="hidden" name="move" value="{{moveid}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-outline-secondary btn-sm mt-2">
                    {{#str}} movecancel, mod_selfselectadvanced, {{user}} {{/str}}
                </button>
            </form>
        {{/rows}}
    {{/hasrows}}
    {{^hasrows}}
        <p class="text-muted">{{#str}} movesnone, mod_selfselectadvanced {{/str}}</p>
    {{/hasrows}}

    <div class="mt-3">
        <a href="{{stageurl}}" class="btn btn-primary">{{#str}} movestage, mod_selfselectadvanced {{/str}}</a>
        <a href="{{backurl}}" class="btn btn-secondary ms-2">{{#str}} back {{/str}}</a>
    </div>
</div>
