{{!
    @template mod_selfselectadvanced/ticket_page

    A ticket's forum-style thread: header, opening post, trail entries as
    posts, an action box at the foot keyed by viewer and status.

    Example context (json):
    {
        "cmid": 1,
        "ticketid": 5,
        "pluginuid": "SSA-PHYS101-T0042",
        "typelabel": "Composition change",
        "subject": "Team Alpha",
        "statuslabel": "Being handled",
        "statusclass": "bg-info text-dark",
        "escalated": false,
        "escalatebadgelabel": "Escalated",
        "wholine": "Being handled.",
        "showwaiting": true,
        "waitinglabel": "Waiting 2 days 3 hours",
        "overdue": false,
        "overduelabel": "Overdue",
        "overduenotice": "",
        "raisedtime": "1 Aug, 09:00",
        "requesterlabel": "Gina Guide",
        "contactline": null,
        "openingpost": "<p>Need a specialist.</p>",
        "openingfiles": [{"filename": "notes.pdf", "url": "https://example.com/pluginfile.php/1/mod_selfselectadvanced/ticketrequest/5/notes.pdf"}],
        "entries": [
            {"actiontext": "Tina Teach took this up.", "actorlabel": "Tina Teach", "hasnote": false, "note": "", "time": "1 Aug, 09:05", "hasfiles": false, "files": []},
            {"actiontext": "Tina Teach asked:", "actorlabel": "Tina Teach", "hasnote": true, "note": "<p>Which subject?</p>", "time": "1 Aug, 09:10", "hasfiles": false, "files": []}
        ],
        "hasentries": true,
        "actionurl": "https://example.com/mod/selfselectadvanced/ticket.php",
        "sesskey": "abc",
        "formatmoodle": 1,
        "backurl": "https://example.com/mod/selfselectadvanced/tickets.php?id=1",
        "backlabel": "Back",
        "showtakeup": false,
        "takeupdisabled": false,
        "takeupreason": "",
        "showclaimantforms": false,
        "showrequestinfo": false,
        "requestinfoformhtml": "",
        "showrelease": false,
        "isguidecap": false,
        "guidecaprequested": 0,
        "resolveformhtml": "",
        "showclaimedbyline": false,
        "claimedbyline": "",
        "showprovideinfo": false,
        "provideinfoformhtml": "",
        "showwithdraw": false,
        "showfeedback": false,
        "feedbackverdicthelped": 1,
        "feedbackverdictnothelped": 2,
        "showescalate": true,
        "escalatenotelabel": "Why does this need to go to an editing teacher or manager?",
        "showrefer": true,
        "showreferempty": false,
        "refertargets": [{"id": 7, "name": "Cora Coordinator"}],
        "showhandoff": true,
        "showhistory": false,
        "history": []
    }
}}
<div class="selfselectadvanced-ticketthread">
    {{! 1.20.54 deliverable A: the status block at the head of the
        thread - the badge, now LABELLED rather than a stray tag; one
        plain line of where this stands and whose move it is
        (ticket_page::whose_move_line()); and, when the viewer is not
        the claimant, who holds it (claimedbyline - the requester's own
        version is anonymised, exactly the "Somebody is handling this."
        idiom myrequests.php already uses). }}
    <div class="selfselectadvanced-ticketstatusblock mb-2">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h3 class="mb-0">{{typelabel}} <span class="text-muted small">({{pluginuid}})</span></h3>
                <span class="text-muted small">{{subject}}</span>
            </div>
            <span>
                <span class="text-muted small me-1">{{#str}} ticketstatus, mod_selfselectadvanced {{/str}}:</span>
                <span class="badge {{statusclass}}">{{statuslabel}}</span>
                {{#escalated}}<span class="badge bg-danger ms-1">{{escalatebadgelabel}}</span>{{/escalated}}
                {{! 1.20.58 deliverable C: independent of status and of the
                    escalated badge, same reason as that badge - an
                    overdue ticket can be open, claimed or needsinfo. }}
                {{#overdue}}<span class="badge bg-danger ms-1">{{overduelabel}}</span>{{/overdue}}
            </span>
        </div>
        <p class="mb-0 mt-1 selfselectadvanced-ticketwholine">{{wholine}}</p>
        {{! 1.20.58 deliverable B: how long the staff clock has been
            running - absent entirely (showwaiting false) while the ball
            is with the requester (needsinfo) or the ticket is closed. }}
        {{#showwaiting}}
            <p class="text-muted small mb-0 selfselectadvanced-ticketwaiting">{{waitinglabel}}</p>
        {{/showwaiting}}
        {{! 1.20.58 deliverable C: the requester's own acknowledgement -
            never silence - kept as its own line rather than folded into
            the badge above, which staff read too but which says nothing
            about being told. }}
        {{#overduenotice}}
            <p class="text-danger small mb-0 selfselectadvanced-ticketoverduenotice">{{overduenotice}}</p>
        {{/overduenotice}}
        {{#showclaimedbyline}}
            <p class="text-muted small mb-0">{{claimedbyline}}</p>
        {{/showclaimedbyline}}
    </div>

    {{! The opening post: author column + content column, forum-shaped. }}
    <div class="selfselectadvanced-threadpost card mb-2">
        <div class="card-body d-flex gap-3">
            <div class="selfselectadvanced-threadauthor text-muted" style="min-width: 10rem;">
                <div>{{requesterlabel}}</div>
                {{#contactline}}<div class="small">{{contactline}}</div>{{/contactline}}
                <div class="small">{{raisedtime}}</div>
            </div>
            <div class="selfselectadvanced-threadcontent flex-grow-1">
                {{{openingpost}}}
                {{#openingfiles}}
                    <div class="selfselectadvanced-threadattachment small">
                        <a href="{{url}}">{{filename}}</a>
                    </div>
                {{/openingfiles}}
            </div>
        </div>
    </div>

    {{#hasentries}}
        {{#entries}}
            {{! 1.20.54 deliverable B: a row that CARRIES A NOTE is a POST
                - the actor in its own author column, beside the
                timestamp, exactly like the opening post above - and a
                row with NO NOTE is a compact EVENT line, visually
                subordinate rather than a full card competing with the
                conversation. Presentation only - tickets::trail() itself,
                and who sees which rows, are unchanged; actiontext keeps
                working exactly as before for the event lines. }}
            {{#hasnote}}
                <div class="selfselectadvanced-threadpost card mb-2">
                    <div class="card-body d-flex gap-3">
                        <div class="selfselectadvanced-threadauthor text-muted" style="min-width: 10rem;">
                            <div>{{actorlabel}}</div>
                            <div class="small">{{time}}</div>
                        </div>
                        <div class="selfselectadvanced-threadcontent flex-grow-1">
                            <div class="small text-muted">{{actiontext}}</div>
                            <div class="mt-1">{{{note}}}</div>
                            {{#hasfiles}}
                                {{#files}}
                                    <div class="selfselectadvanced-threadattachment small mt-1">
                                        <a href="{{url}}">{{filename}}</a>
                                    </div>
                                {{/files}}
                            {{/hasfiles}}
                        </div>
                    </div>
                </div>
            {{/hasnote}}
            {{^hasnote}}
                <div class="selfselectadvanced-threadevent small text-muted border-start ps-2 mb-2">
                    <span>{{time}}</span>
                    <span class="ms-1">{{actiontext}}</span>
                    {{#hasfiles}}
                        {{#files}}
                            <div class="selfselectadvanced-threadattachment mt-1">
                                <a href="{{url}}">{{filename}}</a>
                            </div>
                        {{/files}}
                    {{/hasfiles}}
                </div>
            {{/hasnote}}
        {{/entries}}
    {{/hasentries}}

    {{! The action box - forum's "reply" slot, one control set per viewer+status. }}
    <div class="selfselectadvanced-threadactions border rounded p-3 mb-3">
        {{#showtakeup}}
            {{^takeupdisabled}}
                <form method="post" action="{{actionurl}}">
                    <input type="hidden" name="t" value="{{ticketid}}">
                    <input type="hidden" name="action" value="claim">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn btn-primary">{{#str}} ticketclaim, mod_selfselectadvanced {{/str}}</button>
                </form>
            {{/takeupdisabled}}
            {{#takeupdisabled}}
                <button type="button" class="btn btn-secondary" disabled aria-disabled="true">
                    {{#str}} ticketclaim, mod_selfselectadvanced {{/str}}
                </button>
                <span class="ms-2 text-muted">{{takeupreason}}</span>
            {{/takeupdisabled}}
        {{/showtakeup}}

        {{#showclaimantforms}}
            {{! 1.20.54 deliverable C: the six staff forms (request-info,
                resolve, decline, release, refer, escalate) grouped under
                headings that say what each group does. Every control and
                every predicate that governs it is EXACTLY what it was -
                only the heading and the grouping markup are new; nothing
                here is removed, and nothing new is offered. }}
            {{! 1.20.44 part 2: request-info and resolve/grant are now rendered
                moodleforms (classes/form/ticketpost_form.php) for draft-area
                attachment handling - the PHP-rendered HTML is passed through
                verbatim, unescaped. }}
            {{#showrequestinfo}}
                <div class="selfselectadvanced-ticketgroup mb-3">
                    <h5>{{#str}} ticketthreadgroupaskheading, mod_selfselectadvanced {{/str}}</h5>
                    {{{requestinfoformhtml}}}
                </div>
            {{/showrequestinfo}}

            <div class="selfselectadvanced-ticketgroup mb-3">
                <h5>{{#str}} ticketthreadgroupcloseheading, mod_selfselectadvanced {{/str}}</h5>
                {{{resolveformhtml}}}

                <form method="post" action="{{actionurl}}">
                    <input type="hidden" name="t" value="{{ticketid}}">
                    <input type="hidden" name="action" value="decline">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <div class="mb-2">
                        <label for="selfselectadvanced-threaddecline-{{ticketid}}">
                            {{#str}} ticketthreaddeclinelabel, mod_selfselectadvanced {{/str}}
                        </label>
                        <textarea id="selfselectadvanced-threaddecline-{{ticketid}}" name="declinereason" rows="3"
                            class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-warning">{{#str}} ticketdecline, mod_selfselectadvanced {{/str}}</button>
                </form>
            </div>
        {{/showclaimantforms}}

        {{#showhandoff}}
            <div class="selfselectadvanced-ticketgroup mb-3">
                <h5>{{#str}} ticketthreadgrouphandoffheading, mod_selfselectadvanced {{/str}}</h5>

                {{#showrelease}}
                    {{!
                        The claimant's hand-back-to-the-queue: a bare button,
                        no note field - restored alongside the three forms
                        above (2026-08-15 orchestrator review), not a
                        replacement for any of them.
                    }}
                    <form method="post" action="{{actionurl}}">
                        <input type="hidden" name="t" value="{{ticketid}}">
                        <input type="hidden" name="action" value="release">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button type="submit" class="btn btn-outline-secondary">
                            {{#str}} ticketrelease, mod_selfselectadvanced {{/str}}
                        </button>
                    </form>
                {{/showrelease}}

                {{! The handling ladder (1.20.44): refer to another coordinator, escalate to staff. }}
                {{#showrefer}}
                    <form method="post" action="{{actionurl}}" class="mb-3 selfselectadvanced-ticketrefer">
                        <input type="hidden" name="t" value="{{ticketid}}">
                        <input type="hidden" name="action" value="refer">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <h6>{{#str}} ticketreferheading, mod_selfselectadvanced {{/str}}</h6>
                        <div class="mb-2">
                            <label for="selfselectadvanced-threadrefertarget-{{ticketid}}">
                                {{#str}} ticketrefertargetlabel, mod_selfselectadvanced {{/str}}
                            </label>
                            <select id="selfselectadvanced-threadrefertarget-{{ticketid}}" name="target" class="form-select">
                                {{#refertargets}}
                                    <option value="{{id}}">{{name}}</option>
                                {{/refertargets}}
                            </select>
                        </div>
                        <div class="mb-2">
                            <label for="selfselectadvanced-threadrefernote-{{ticketid}}">
                                {{#str}} ticketrefernotelabel, mod_selfselectadvanced {{/str}}
                            </label>
                            <textarea id="selfselectadvanced-threadrefernote-{{ticketid}}" name="note" rows="3"
                                class="form-control" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-secondary">
                            {{#str}} ticketrefersend, mod_selfselectadvanced {{/str}}
                        </button>
                    </form>
                {{/showrefer}}
                {{#showreferempty}}
                    <p class="text-muted small">{{#str}} ticketrefertargetempty, mod_selfselectadvanced {{/str}}</p>
                {{/showreferempty}}

                {{#showescalate}}
                    <form method="post" action="{{actionurl}}" class="mb-3 selfselectadvanced-ticketescalate">
                        <input type="hidden" name="t" value="{{ticketid}}">
                        <input type="hidden" name="action" value="escalate">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <div class="mb-2">
                            <label for="selfselectadvanced-threadescalatenote-{{ticketid}}">
                                {{escalatenotelabel}}
                            </label>
                            <textarea id="selfselectadvanced-threadescalatenote-{{ticketid}}" name="note" rows="3"
                                class="form-control" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-danger">
                            {{#str}} ticketescalate, mod_selfselectadvanced {{/str}}
                        </button>
                    </form>
                {{/showescalate}}
            </div>
        {{/showhandoff}}

        {{! 1.20.44 part 2: rendered moodleform, same reason as request-info/resolve above. }}
        {{#showprovideinfo}}
            {{{provideinfoformhtml}}}
        {{/showprovideinfo}}

        {{#showwithdraw}}
            <form method="post" action="{{actionurl}}">
                <input type="hidden" name="t" value="{{ticketid}}">
                <input type="hidden" name="action" value="withdraw">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-outline-secondary">
                    {{#str}} myrequestswithdraw, mod_selfselectadvanced {{/str}}
                </button>
            </form>
        {{/showwithdraw}}

        {{! 1.20.59 deliverable A: "did this help?" - the requester's own
            answer, offered once. The notice that answering is final is
            said BEFORE the buttons, not after (spec: "the screen must
            say so before they answer"). One shared optional note field,
            two submit buttons carrying the verdict as their own value -
            no radio button needed, and no JavaScript. }}
        {{#showfeedback}}
            <div class="selfselectadvanced-ticketgroup selfselectadvanced-ticketfeedback mb-3">
                <h5>{{#str}} ticketfeedbackheading, mod_selfselectadvanced {{/str}}</h5>
                <p class="text-muted small">{{#str}} ticketfeedbackoncenotice, mod_selfselectadvanced {{/str}}</p>
                <form method="post" action="{{actionurl}}">
                    <input type="hidden" name="t" value="{{ticketid}}">
                    <input type="hidden" name="action" value="feedback">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <div class="mb-2">
                        <label for="selfselectadvanced-threadfeedbacknote-{{ticketid}}">
                            {{#str}} ticketfeedbacknotelabel, mod_selfselectadvanced {{/str}}
                        </label>
                        <textarea id="selfselectadvanced-threadfeedbacknote-{{ticketid}}" name="feedbacknote" rows="2"
                            class="form-control"></textarea>
                    </div>
                    <button type="submit" name="verdict" value="{{feedbackverdicthelped}}" class="btn btn-success">
                        {{#str}} ticketfeedbackyes, mod_selfselectadvanced {{/str}}
                    </button>
                    <button type="submit" name="verdict" value="{{feedbackverdictnothelped}}" class="btn btn-outline-danger ms-1">
                        {{#str}} ticketfeedbackno, mod_selfselectadvanced {{/str}}
                    </button>
                </form>
            </div>
        {{/showfeedback}}
    </div>

    {{#showhistory}}
        <div class="selfselectadvanced-threadhistory mt-4">
            <h4>{{#str}} ticketthreadhistoryheading, mod_selfselectadvanced {{/str}}</h4>
            <ul class="list-group">
                {{#history}}
                    <li class="list-group-item">
                        <a href="{{url}}">{{subject}}</a>
                        <span class="text-muted small ms-2">{{typelabel}} · {{statuslabel}} · {{date}}</span>
                    </li>
                {{/history}}
            </ul>
        </div>
    {{/showhistory}}

    <a href="{{backurl}}" class="btn btn-secondary mt-3">{{backlabel}}</a>
</div>
