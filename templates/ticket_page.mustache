{{!
    @template mod_selfselectadvanced/ticket_page

    A ticket's forum-style thread: header, opening post, trail entries as
    posts, an action box at the foot keyed by viewer and status.

    Example context (json):
    {
        "cmid": 1,
        "ticketid": 5,
        "typelabel": "Composition change",
        "subject": "Team Alpha",
        "statuslabel": "Being handled",
        "statusclass": "bg-info text-dark",
        "escalated": false,
        "escalatebadgelabel": "Escalated",
        "raisedtime": "1 Aug, 09:00",
        "requesterlabel": "Gina Guide",
        "contactline": null,
        "openingpost": "<p>Need a specialist.</p>",
        "openingfiles": [{"filename": "notes.pdf", "url": "https://example.com/pluginfile.php/1/mod_selfselectadvanced/ticketrequest/5/notes.pdf"}],
        "entries": [{"actiontext": "Tina Teach took this up.", "hasnote": false, "note": "", "time": "1 Aug, 09:05", "hasfiles": false, "files": []}],
        "hasentries": true,
        "actionurl": "https://example.com/mod/selfselectadvanced/ticket.php",
        "sesskey": "abc",
        "formatmoodle": 1,
        "backurl": "https://example.com/mod/selfselectadvanced/tickets.php?id=1",
        "backlabel": "Back",
        "showtakeup": false,
        "takeupdisabled": false,
        "takeupreason": "",
        "showclaimantforms": false,
        "showrequestinfo": false,
        "requestinfoformhtml": "",
        "showrelease": false,
        "isguidecap": false,
        "guidecaprequested": 0,
        "resolveformhtml": "",
        "showclaimedbyline": false,
        "claimedbyline": "",
        "showprovideinfo": false,
        "provideinfoformhtml": "",
        "showwithdraw": false,
        "showescalate": true,
        "escalatenotelabel": "Why does this need to go to an editing teacher or manager?",
        "showrefer": true,
        "showreferempty": false,
        "refertargets": [{"id": 7, "name": "Cora Coordinator"}],
        "showhistory": false,
        "history": []
    }
}}
<div class="selfselectadvanced-ticketthread">
    <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
        <div>
            <h3 class="mb-0">{{typelabel}}</h3>
            <span class="text-muted small">{{subject}}</span>
        </div>
        <span>
            <span class="badge {{statusclass}}">{{statuslabel}}</span>
            {{#escalated}}<span class="badge bg-danger ms-1">{{escalatebadgelabel}}</span>{{/escalated}}
        </span>
    </div>

    {{! The opening post: author column + content column, forum-shaped. }}
    <div class="selfselectadvanced-threadpost card mb-2">
        <div class="card-body d-flex gap-3">
            <div class="selfselectadvanced-threadauthor text-muted" style="min-width: 10rem;">
                <div>{{requesterlabel}}</div>
                {{#contactline}}<div class="small">{{contactline}}</div>{{/contactline}}
                <div class="small">{{raisedtime}}</div>
            </div>
            <div class="selfselectadvanced-threadcontent flex-grow-1">
                {{{openingpost}}}
                {{#openingfiles}}
                    <div class="selfselectadvanced-threadattachment small">
                        <a href="{{url}}">{{filename}}</a>
                    </div>
                {{/openingfiles}}
            </div>
        </div>
    </div>

    {{#hasentries}}
        {{#entries}}
            <div class="selfselectadvanced-threadpost card mb-2">
                <div class="card-body d-flex gap-3">
                    <div class="selfselectadvanced-threadauthor text-muted" style="min-width: 10rem;">
                        <div class="small">{{time}}</div>
                    </div>
                    <div class="selfselectadvanced-threadcontent flex-grow-1">
                        <div>{{actiontext}}</div>
                        {{#hasnote}}<div class="mt-1">{{{note}}}</div>{{/hasnote}}
                        {{#hasfiles}}
                            {{#files}}
                                <div class="selfselectadvanced-threadattachment small mt-1">
                                    <a href="{{url}}">{{filename}}</a>
                                </div>
                            {{/files}}
                        {{/hasfiles}}
                    </div>
                </div>
            </div>
        {{/entries}}
    {{/hasentries}}

    {{! The action box - forum's "reply" slot, one control set per viewer+status. }}
    <div class="selfselectadvanced-threadactions border rounded p-3 mb-3">
        {{#showtakeup}}
            {{^takeupdisabled}}
                <form method="post" action="{{actionurl}}">
                    <input type="hidden" name="t" value="{{ticketid}}">
                    <input type="hidden" name="action" value="claim">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn btn-primary">{{#str}} ticketclaim, mod_selfselectadvanced {{/str}}</button>
                </form>
            {{/takeupdisabled}}
            {{#takeupdisabled}}
                <button type="button" class="btn btn-secondary" disabled aria-disabled="true">
                    {{#str}} ticketclaim, mod_selfselectadvanced {{/str}}
                </button>
                <span class="ms-2 text-muted">{{takeupreason}}</span>
            {{/takeupdisabled}}
        {{/showtakeup}}

        {{#showclaimantforms}}
            {{! 1.20.44 part 2: request-info and resolve/grant are now rendered
                moodleforms (classes/form/ticketpost_form.php) for draft-area
                attachment handling - the PHP-rendered HTML is passed through
                verbatim, unescaped. }}
            {{#showrequestinfo}}
                {{{requestinfoformhtml}}}
            {{/showrequestinfo}}

            {{{resolveformhtml}}}

            <form method="post" action="{{actionurl}}">
                <input type="hidden" name="t" value="{{ticketid}}">
                <input type="hidden" name="action" value="decline">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div class="mb-2">
                    <label for="selfselectadvanced-threaddecline-{{ticketid}}">
                        {{#str}} ticketthreaddeclinelabel, mod_selfselectadvanced {{/str}}
                    </label>
                    <textarea id="selfselectadvanced-threaddecline-{{ticketid}}" name="declinereason" rows="3"
                        class="form-control"></textarea>
                </div>
                <button type="submit" class="btn btn-warning">{{#str}} ticketdecline, mod_selfselectadvanced {{/str}}</button>
            </form>

            {{#showrelease}}
                {{!
                    The claimant's hand-back-to-the-queue: a bare button,
                    no note field - restored alongside the three forms
                    above (2026-08-15 orchestrator review), not a
                    replacement for any of them.
                }}
                <form method="post" action="{{actionurl}}">
                    <input type="hidden" name="t" value="{{ticketid}}">
                    <input type="hidden" name="action" value="release">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn btn-outline-secondary">
                        {{#str}} ticketrelease, mod_selfselectadvanced {{/str}}
                    </button>
                </form>
            {{/showrelease}}
        {{/showclaimantforms}}

        {{#showclaimedbyline}}
            <p class="text-muted mb-0">{{claimedbyline}}</p>
        {{/showclaimedbyline}}

        {{! The handling ladder (1.20.44): refer to another coordinator, escalate to staff. }}
        {{#showrefer}}
            <form method="post" action="{{actionurl}}" class="mb-3 selfselectadvanced-ticketrefer">
                <input type="hidden" name="t" value="{{ticketid}}">
                <input type="hidden" name="action" value="refer">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <h5>{{#str}} ticketreferheading, mod_selfselectadvanced {{/str}}</h5>
                <div class="mb-2">
                    <label for="selfselectadvanced-threadrefertarget-{{ticketid}}">
                        {{#str}} ticketrefertargetlabel, mod_selfselectadvanced {{/str}}
                    </label>
                    <select id="selfselectadvanced-threadrefertarget-{{ticketid}}" name="target" class="form-select">
                        {{#refertargets}}
                            <option value="{{id}}">{{name}}</option>
                        {{/refertargets}}
                    </select>
                </div>
                <div class="mb-2">
                    <label for="selfselectadvanced-threadrefernote-{{ticketid}}">
                        {{#str}} ticketrefernotelabel, mod_selfselectadvanced {{/str}}
                    </label>
                    <textarea id="selfselectadvanced-threadrefernote-{{ticketid}}" name="note" rows="3"
                        class="form-control" required></textarea>
                </div>
                <button type="submit" class="btn btn-secondary">
                    {{#str}} ticketrefersend, mod_selfselectadvanced {{/str}}
                </button>
            </form>
        {{/showrefer}}
        {{#showreferempty}}
            <p class="text-muted small">{{#str}} ticketrefertargetempty, mod_selfselectadvanced {{/str}}</p>
        {{/showreferempty}}

        {{#showescalate}}
            <form method="post" action="{{actionurl}}" class="mb-3 selfselectadvanced-ticketescalate">
                <input type="hidden" name="t" value="{{ticketid}}">
                <input type="hidden" name="action" value="escalate">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div class="mb-2">
                    <label for="selfselectadvanced-threadescalatenote-{{ticketid}}">
                        {{escalatenotelabel}}
                    </label>
                    <textarea id="selfselectadvanced-threadescalatenote-{{ticketid}}" name="note" rows="3"
                        class="form-control" required></textarea>
                </div>
                <button type="submit" class="btn btn-outline-danger">
                    {{#str}} ticketescalate, mod_selfselectadvanced {{/str}}
                </button>
            </form>
        {{/showescalate}}

        {{! 1.20.44 part 2: rendered moodleform, same reason as request-info/resolve above. }}
        {{#showprovideinfo}}
            {{{provideinfoformhtml}}}
        {{/showprovideinfo}}

        {{#showwithdraw}}
            <form method="post" action="{{actionurl}}">
                <input type="hidden" name="t" value="{{ticketid}}">
                <input type="hidden" name="action" value="withdraw">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-outline-secondary">
                    {{#str}} myrequestswithdraw, mod_selfselectadvanced {{/str}}
                </button>
            </form>
        {{/showwithdraw}}
    </div>

    {{#showhistory}}
        <div class="selfselectadvanced-threadhistory mt-4">
            <h4>{{#str}} ticketthreadhistoryheading, mod_selfselectadvanced {{/str}}</h4>
            <ul class="list-group">
                {{#history}}
                    <li class="list-group-item">
                        <a href="{{url}}">{{subject}}</a>
                        <span class="text-muted small ms-2">{{typelabel}} · {{statuslabel}} · {{date}}</span>
                    </li>
                {{/history}}
            </ul>
        </div>
    {{/showhistory}}

    <a href="{{backurl}}" class="btn btn-secondary mt-3">{{backlabel}}</a>
</div>
