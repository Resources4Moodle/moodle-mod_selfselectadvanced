{{!
    @template mod_selfselectadvanced/guide_dashboard

    Guide dashboard: own load header, review queue, guided groups.

    Context variables required for this template:
    * loadline - "You are guiding 3 of 10 groups"
    * hasqueue - whether the queue has entries
    * queue[].canaccept / acceptblocked / decided - the decision in the row itself (1.19 A)
    * showqueue - whether the review queue tab is the one being shown
    * showguided - whether the guided-teams tab is the one being shown
    * showvolunteer - whether guide volunteering is enabled for this activity
    * volunteer - hasvolunteered, statusline, callline, showgrandfathered, grandfatherline, options[]
    * eoienabled - whether team listing and guide interest (EOI) is enabled
    * haseoicards - whether eoicards has entries (mirrors eoienabled)
    * eoicards - label, number, url for each of the four stat cards
    * pickteamurl - link to the pick-a-team browse page
    * guided[].canopenteam - whether this viewer's capabilities open group.php at all
    * guided[].teamurl - link to the team's own page (1.20.1: the route the dashboard never had)
    * guided[].isformingassigned - true for a still-forming team pre-assigned via EOI
    * guided[].stepouturl - link for the step-out confirm step (isformingassigned rows only)

    Example context (json):
    {
        "loadline": "You are guiding 3 of 10 groups",
        "hasqueue": true,
        "showqueue": true,
        "showguided": true,
        "showvolunteer": true,
        "volunteer": {
            "hasvolunteered": true,
            "statusline": "You have volunteered to guide up to 3 of 10 groups.",
            "callline": "You have not volunteered to guide any groups yet.",
            "showgrandfathered": false,
            "grandfatherline": "",
            "options": [
                {"value": 0, "label": "0 (withdraw)", "selected": false},
                {"value": 3, "label": "3", "selected": true}
            ]
        },
        "eoienabled": true,
        "haseoicards": true,
        "eoicards": [
            {"label": "Teams you guide", "number": 3, "url": "https://example.com/mod/selfselectadvanced/guideload.php?id=1&guide=2"},
            {"label": "Interests awaiting a leader", "number": 1, "url": "https://example.com/mod/selfselectadvanced/eoilist.php?id=1&status=pending"},
            {"label": "Interests timed out", "number": 0, "url": "https://example.com/mod/selfselectadvanced/eoilist.php?id=1&status=expired"},
            {"label": "Interests declined", "number": 2, "url": "https://example.com/mod/selfselectadvanced/eoilist.php?id=1&status=rejected"}
        ],
        "pickteamurl": "https://example.com/mod/selfselectadvanced/pickteam.php?id=1",
        "queue": [
            {
                "pluginuid": "SSA-C101-0001",
                "name": "Team Alpha",
                "title": "Pendulums",
                "statelabel": "Awaiting guide",
                "size": 4,
                "reviewurl": "https://example.com/mod/selfselectadvanced/review.php?id=1&g=1"
            }
        ],
        "hasguided": true,
        "guided": [
            {
                "groupid": 2,
                "name": "Team Beta",
                "pluginuid": "SSA-C101-0002",
                "statelabel": "Forming",
                "size": 3,
                "reviewurl": "https://example.com/mod/selfselectadvanced/review.php?id=1&g=2",
                "canfreeze": false,
                "canrelease": false,
                "stafffroze": false,
                "freezeurl": "https://example.com/mod/selfselectadvanced/group.php?id=1&g=2&action=freeze",
                "canopenteam": true,
                "teamurl": "https://example.com/mod/selfselectadvanced/group.php?id=1&g=2",
                "isformingassigned": true,
                "stepouturl": "https://example.com/mod/selfselectadvanced/guide.php?id=1&action=stepout&g=2"
            }
        ],
        "backurl": "https://example.com/mod/selfselectadvanced/view.php?id=1",
        "actionurl": "https://example.com/mod/selfselectadvanced/guide.php?id=1"
    }
}}
<div class="selfselectadvanced-guidedashboard">
    <p><span class="badge bg-light text-body border">{{loadline}}</span></p>

    {{#eoienabled}}
        <div class="selfselectadvanced-eoicards mb-3">
            {{#haseoicards}}
                <div class="ssa-cards">
                    {{#eoicards}}
                        <a class="ssa-card" href="{{url}}">
                            <div class="ssa-card-number">{{number}}</div>
                            <div class="ssa-card-label">{{label}}</div>
                        </a>
                    {{/eoicards}}
                </div>
            {{/haseoicards}}
            <a class="btn btn-primary btn-sm mt-2" href="{{pickteamurl}}">
                {{#str}} eoibrowseteams, mod_selfselectadvanced {{/str}}
            </a>
        </div>
    {{/eoienabled}}

    {{#showvolunteer}}
        <div class="selfselectadvanced-volunteer mb-3">
            <h3>{{#str}} volunteerheading, mod_selfselectadvanced {{/str}}</h3>
            <p>
                {{#volunteer.hasvolunteered}}{{volunteer.statusline}}{{/volunteer.hasvolunteered}}
                {{^volunteer.hasvolunteered}}{{volunteer.callline}}{{/volunteer.hasvolunteered}}
            </p>
            {{#volunteer.showgrandfathered}}
                <p class="text-muted">{{volunteer.grandfatherline}}</p>
            {{/volunteer.showgrandfathered}}
            <form method="post" action="{{actionurl}}" class="d-flex flex-wrap gap-2 align-items-end">
                <input type="hidden" name="id" value="{{cmid}}">
                <input type="hidden" name="action" value="volunteer">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <label>{{#str}} volunteerlabel, mod_selfselectadvanced {{/str}}
                    <select name="capacity" class="form-select form-select-sm">
                        {{#volunteer.options}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/volunteer.options}}
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">
                    {{#str}} volunteersave, mod_selfselectadvanced {{/str}}
                </button>
            </form>
        </div>
    {{/showvolunteer}}

    {{#showqueue}}
    <h3>{{#str}} reviewqueue, mod_selfselectadvanced {{/str}}</h3>
    {{#hasqueue}}
        <div class="table-responsive">
            <table class="table generaltable">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} groupname, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} pluginid, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} worktitle, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} size, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} actions {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#queue}}
                        <tr>
                            <td>{{name}}</td>
                            <td>{{pluginuid}}</td>
                            <td>{{title}}</td>
                            <td>{{size}}</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1 align-items-start">
                                    <a class="btn btn-outline-secondary btn-sm" href="{{reviewurl}}">
                                        {{#str}} review, mod_selfselectadvanced {{/str}}
                                    </a>
                                    {{#decided}}
                                        <button type="button" class="btn btn-secondary btn-sm" disabled
                                                aria-disabled="true">{{decided}}</button>
                                    {{/decided}}
                                    {{^decided}}
                                        {{#canaccept}}
                                            <form method="post" action="{{actionurl}}" class="d-inline">
                                                <input type="hidden" name="id" value="{{cmid}}">
                                                <input type="hidden" name="action" value="queueaccept">
                                                <input type="hidden" name="g" value="{{groupid}}">
                                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    {{#str}} queueaccept, mod_selfselectadvanced {{/str}}
                                                </button>
                                            </form>
                                            <form method="post" action="{{actionurl}}"
                                                  class="d-inline-flex gap-1 align-items-start">
                                                <input type="hidden" name="id" value="{{cmid}}">
                                                <input type="hidden" name="action" value="queuereturn">
                                                <input type="hidden" name="g" value="{{groupid}}">
                                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                                <label class="visually-hidden" for="ssa-qr-{{groupid}}">
                                                    {{#str}} returncommentlabel, mod_selfselectadvanced {{/str}}
                                                </label>
                                                <input type="text" id="ssa-qr-{{groupid}}" name="comment"
                                                       class="form-control form-control-sm"
                                                       placeholder="{{#str}} queuereturnhint, mod_selfselectadvanced {{/str}}">
                                                <button type="submit" class="btn btn-outline-warning btn-sm">
                                                    {{#str}} queuereturn, mod_selfselectadvanced {{/str}}
                                                </button>
                                            </form>
                                        {{/canaccept}}
                                        {{#acceptblocked}}
                                            <button type="button" class="btn btn-secondary btn-sm" disabled
                                                    aria-disabled="true">
                                                {{#str}} queueaccept, mod_selfselectadvanced {{/str}}
                                            </button>
                                            <span class="text-muted small">{{acceptblocked}}</span>
                                        {{/acceptblocked}}
                                    {{/decided}}
                                </div>
                            </td>
                        </tr>
                    {{/queue}}
                </tbody>
            </table>
        </div>
    {{/hasqueue}}
    {{^hasqueue}}
        <p class="text-muted">{{#str}} queueempty, mod_selfselectadvanced {{/str}}</p>
    {{/hasqueue}}
    {{/showqueue}}

    {{#showguided}}
    <h3>{{#str}} guidedgroups, mod_selfselectadvanced {{/str}}</h3>

    <form method="get" action="{{actionurl}}" class="selfselectadvanced-guidefilters mb-3 d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="id" value="{{cmid}}">
        <label>{{#str}} state, mod_selfselectadvanced {{/str}}
            <select name="fstate" class="form-select form-select-sm">
                <option value="">{{#str}} all {{/str}}</option>
                {{#filters.stateoptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/filters.stateoptions}}
            </select>
        </label>
        <label>{{#str}} filterquota, mod_selfselectadvanced {{/str}}
            <select name="fquota" class="form-select form-select-sm">
                <option value="">{{#str}} all {{/str}}</option>
                <option value="yes" {{#filters.fquotayes}}selected{{/filters.fquotayes}}>{{#str}} yes {{/str}}</option>
                <option value="no" {{#filters.fquotano}}selected{{/filters.fquotano}}>{{#str}} no {{/str}}</option>
            </select>
        </label>
        <label>{{#str}} attrdepartment, mod_selfselectadvanced {{/str}}
            <select name="fdept" class="form-select form-select-sm">
                <option value="">{{#str}} all {{/str}}</option>
                {{#filters.deptoptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>
                {{/filters.deptoptions}}
            </select>
        </label>
        <label>{{#str}} filterapproved, mod_selfselectadvanced {{/str}}
            <select name="fapprovedop" class="form-select form-select-sm">
                <option value="">{{#str}} all {{/str}}</option>
                <option value="before" {{#filters.fbefore}}selected{{/filters.fbefore}}>{{#str}} filterbefore, mod_selfselectadvanced {{/str}}</option>
                <option value="after" {{#filters.fafter}}selected{{/filters.fafter}}>{{#str}} filterafter, mod_selfselectadvanced {{/str}}</option>
            </select>
        </label>
        <label>{{#str}} filterdate, mod_selfselectadvanced {{/str}}
            <input type="date" name="fapproved" value="{{filters.fapproved}}"
                max="9999-12-31" class="form-control form-control-sm">
        </label>
        <button type="submit" class="btn btn-secondary btn-sm">{{#str}} filter {{/str}}</button>
    </form>

    {{#hasguided}}
        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="action" value="bulkfreeze">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div class="table-responsive">
                <table class="table generaltable">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} select {{/str}}</th>
                            <th scope="col">{{#str}} groupname, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} pluginid, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} state, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} size, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} actions {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#guided}}
                            <tr>
                                <td>
                                    {{#canfreeze}}
                                        <input type="checkbox" name="selected[]" value="{{groupid}}"
                                            id="ssabulkfreeze{{groupid}}">
                                        <label class="visually-hidden" for="ssabulkfreeze{{groupid}}">
                                            {{#str}} select {{/str}} {{name}}
                                        </label>
                                    {{/canfreeze}}
                                </td>
                                <td>{{name}}</td>
                                <td>{{pluginuid}}</td>
                                <td>{{statelabel}}</td>
                                <td>{{size}}</td>
                                <td>
                                    {{#canopenteam}}
                                        <a class="btn btn-outline-secondary btn-sm" href="{{teamurl}}">{{#str}} viewteam, mod_selfselectadvanced {{/str}}</a>
                                    {{/canopenteam}}
                                    {{^isformingassigned}}
                                        <a class="btn btn-secondary btn-sm" href="{{reviewurl}}">{{#str}} review, mod_selfselectadvanced {{/str}}</a>
                                        {{#canfreeze}}
                                            <a class="btn btn-primary btn-sm" href="{{freezeurl}}">{{#str}} freeze, mod_selfselectadvanced {{/str}}</a>
                                        {{/canfreeze}}
                                        {{#canrelease}}
                                            <a class="btn btn-outline-primary btn-sm" href="{{releaseurl}}">{{#str}} release, mod_selfselectadvanced {{/str}}</a>
                                        {{/canrelease}}
                                        {{#stafffroze}}
                                            <button type="button" class="btn btn-secondary btn-sm" disabled
                                                    aria-disabled="true">{{#str}} release, mod_selfselectadvanced {{/str}}</button>
                                            <span class="text-muted small">{{#str}} releasestafffroze, mod_selfselectadvanced {{/str}}</span>
                                        {{/stafffroze}}
                                    {{/isformingassigned}}
                                    {{#isformingassigned}}
                                        <a class="btn btn-secondary btn-sm" href="{{stepouturl}}">{{#str}} eoistepout, mod_selfselectadvanced {{/str}}</a>
                                    {{/isformingassigned}}
                                </td>
                            </tr>
                        {{/guided}}
                    </tbody>
                </table>
            </div>
            {{#canbulkfreeze}}
                <button type="submit" class="btn btn-primary">{{#str}} bulkfreezeselected, mod_selfselectadvanced {{/str}}</button>
            {{/canbulkfreeze}}
        </form>
    {{/hasguided}}
    {{^hasguided}}
        <p class="text-muted">{{#str}} noguidedgroups, mod_selfselectadvanced {{/str}}</p>
    {{/hasguided}}
    {{/showguided}}

    <a href="{{backurl}}" class="btn btn-secondary">{{#str}} back {{/str}}</a>
</div>
