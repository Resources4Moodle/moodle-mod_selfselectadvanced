{{!
    @template mod_selfselectadvanced/guide_dashboard

    Guide dashboard: own load header, review queue, guided groups.

    Context variables required for this template:
    * loadline - "You are guiding 3 of 10 groups"
    * hasqueue - whether the queue has entries
    * showvolunteer - whether guide volunteering is enabled for this activity
    * volunteer - hasvolunteered, statusline, callline, showgrandfathered, grandfatherline, options[]

    Example context (json):
    {
        "loadline": "You are guiding 3 of 10 groups",
        "hasqueue": true,
        "showvolunteer": true,
        "volunteer": {
            "hasvolunteered": true,
            "statusline": "You have volunteered to guide up to 3 of 10 groups.",
            "callline": "You have not volunteered to guide any groups yet.",
            "showgrandfathered": false,
            "grandfatherline": "",
            "options": [
                {"value": 0, "label": "0 (withdraw)", "selected": false},
                {"value": 3, "label": "3", "selected": true}
            ]
        },
        "queue": [
            {
                "pluginuid": "SSA-C101-0001",
                "name": "Team Alpha",
                "title": "Pendulums",
                "statelabel": "Awaiting guide",
                "size": 4,
                "reviewurl": "https://example.com/mod/selfselectadvanced/review.php?id=1&g=1"
            }
        ],
        "hasguided": false,
        "guided": [],
        "backurl": "https://example.com/mod/selfselectadvanced/view.php?id=1",
        "actionurl": "https://example.com/mod/selfselectadvanced/guide.php?id=1"
    }
}}
<div class="selfselectadvanced-guidedashboard">
    <p><span class="badge bg-light text-body border">{{loadline}}</span></p>

    {{#showvolunteer}}
        <div class="selfselectadvanced-volunteer mb-3">
            <h3>{{#str}} volunteerheading, mod_selfselectadvanced {{/str}}</h3>
            <p>
                {{#volunteer.hasvolunteered}}{{volunteer.statusline}}{{/volunteer.hasvolunteered}}
                {{^volunteer.hasvolunteered}}{{volunteer.callline}}{{/volunteer.hasvolunteered}}
            </p>
            {{#volunteer.showgrandfathered}}
                <p class="text-muted">{{volunteer.grandfatherline}}</p>
            {{/volunteer.showgrandfathered}}
            <form method="post" action="{{actionurl}}" class="d-flex flex-wrap gap-2 align-items-end">
                <input type="hidden" name="id" value="{{cmid}}">
                <input type="hidden" name="action" value="volunteer">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <label>{{#str}} volunteerlabel, mod_selfselectadvanced {{/str}}
                    <select name="capacity" class="form-select form-select-sm">
                        {{#volunteer.options}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/volunteer.options}}
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">
                    {{#str}} volunteersave, mod_selfselectadvanced {{/str}}
                </button>
            </form>
        </div>
    {{/showvolunteer}}

    <h3>{{#str}} reviewqueue, mod_selfselectadvanced {{/str}}</h3>
    {{#hasqueue}}
        <div class="table-responsive">
            <table class="table generaltable">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} groupname, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} pluginid, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} worktitle, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} size, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} actions {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#queue}}
                        <tr>
                            <td>{{name}}</td>
                            <td>{{pluginuid}}</td>
                            <td>{{title}}</td>
                            <td>{{size}}</td>
                            <td><a class="btn btn-primary btn-sm" href="{{reviewurl}}">{{#str}} review, mod_selfselectadvanced {{/str}}</a></td>
                        </tr>
                    {{/queue}}
                </tbody>
            </table>
        </div>
    {{/hasqueue}}
    {{^hasqueue}}
        <p class="text-muted">{{#str}} queueempty, mod_selfselectadvanced {{/str}}</p>
    {{/hasqueue}}

    <h3>{{#str}} guidedgroups, mod_selfselectadvanced {{/str}}</h3>

    <form method="get" action="{{actionurl}}" class="selfselectadvanced-guidefilters mb-3 d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="id" value="{{cmid}}">
        <label>{{#str}} state, mod_selfselectadvanced {{/str}}
            <select name="fstate" class="form-select form-select-sm">
                <option value="">{{#str}} all {{/str}}</option>
                {{#filters.stateoptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/filters.stateoptions}}
            </select>
        </label>
        <label>{{#str}} filterquota, mod_selfselectadvanced {{/str}}
            <select name="fquota" class="form-select form-select-sm">
                <option value="">{{#str}} all {{/str}}</option>
                <option value="yes" {{#filters.fquotayes}}selected{{/filters.fquotayes}}>{{#str}} yes {{/str}}</option>
                <option value="no" {{#filters.fquotano}}selected{{/filters.fquotano}}>{{#str}} no {{/str}}</option>
            </select>
        </label>
        <label>{{#str}} attrdepartment, mod_selfselectadvanced {{/str}}
            <select name="fdept" class="form-select form-select-sm">
                <option value="">{{#str}} all {{/str}}</option>
                {{#filters.deptoptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>
                {{/filters.deptoptions}}
            </select>
        </label>
        <label>{{#str}} filterapproved, mod_selfselectadvanced {{/str}}
            <select name="fapprovedop" class="form-select form-select-sm">
                <option value="">{{#str}} all {{/str}}</option>
                <option value="before" {{#filters.fbefore}}selected{{/filters.fbefore}}>{{#str}} filterbefore, mod_selfselectadvanced {{/str}}</option>
                <option value="after" {{#filters.fafter}}selected{{/filters.fafter}}>{{#str}} filterafter, mod_selfselectadvanced {{/str}}</option>
            </select>
        </label>
        <label>{{#str}} filterdate, mod_selfselectadvanced {{/str}}
            <input type="date" name="fapproved" value="{{filters.fapproved}}"
                max="9999-12-31" class="form-control form-control-sm">
        </label>
        <button type="submit" class="btn btn-secondary btn-sm">{{#str}} filter {{/str}}</button>
    </form>

    {{#hasguided}}
        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="action" value="bulkfreeze">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div class="table-responsive">
                <table class="table generaltable">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} select {{/str}}</th>
                            <th scope="col">{{#str}} groupname, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} pluginid, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} state, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} size, mod_selfselectadvanced {{/str}}</th>
                            <th scope="col">{{#str}} actions {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#guided}}
                            <tr>
                                <td>
                                    {{#canfreeze}}
                                        <input type="checkbox" name="selected[]" value="{{groupid}}" checked
                                            aria-label="{{#str}} select {{/str}} {{name}}">
                                    {{/canfreeze}}
                                </td>
                                <td>{{name}}</td>
                                <td>{{pluginuid}}</td>
                                <td>{{statelabel}}</td>
                                <td>{{size}}</td>
                                <td>
                                    <a class="btn btn-secondary btn-sm" href="{{reviewurl}}">{{#str}} review, mod_selfselectadvanced {{/str}}</a>
                                    {{#canfreeze}}
                                        <a class="btn btn-primary btn-sm" href="{{freezeurl}}">{{#str}} freeze, mod_selfselectadvanced {{/str}}</a>
                                    {{/canfreeze}}
                                </td>
                            </tr>
                        {{/guided}}
                    </tbody>
                </table>
            </div>
            {{#canbulkfreeze}}
                <button type="submit" class="btn btn-primary">{{#str}} bulkfreezeselected, mod_selfselectadvanced {{/str}}</button>
            {{/canbulkfreeze}}
        </form>
    {{/hasguided}}
    {{^hasguided}}
        <p class="text-muted">{{#str}} noguidedgroups, mod_selfselectadvanced {{/str}}</p>
    {{/hasguided}}

    <a href="{{backurl}}" class="btn btn-secondary">{{#str}} back {{/str}}</a>
</div>
