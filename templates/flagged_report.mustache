{{!
    @template mod_selfselectadvanced/flagged_report

    Flagged students and group anomalies.

    Context variables required for this template:
    * hasgroupless - whether groupless students exist
    * grouplesscount - their number
    * missingattrstable - pre-rendered flexible_table HTML (flagged_missingattrs_table)
    * anomaliestable - pre-rendered flexible_table HTML (flagged_anomalies_table)

    Example context (json):
    {
        "hasgroupless": true,
        "grouplesscount": 1,
        "groupless": [{"fullname": "Sam One", "attrline": "Female · Civil",
                       "placeurl": "https://example.com/moveedit"}],
        "hasmissingattrs": true,
        "missingattrstable": "<table></table>",
        "hasanomalies": false,
        "anomaliestable": "",
        "backurl": "https://example.com/back"
    }
}}
<div class="selfselectadvanced-flagged">
    <h3>{{#str}} flaggedreport, mod_selfselectadvanced {{/str}}</h3>

    <h4>{{#str}} flaggroupless, mod_selfselectadvanced, {{grouplesscount}} {{/str}}</h4>
    {{#hasgroupless}}
        <ul class="list-group mb-4">
            {{#groupless}}
                <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                    <span>
                        {{fullname}}
                        <span class="d-block text-muted small">{{attrline}}</span>
                    </span>
                    <a href="{{placeurl}}" class="btn btn-primary btn-sm">
                        {{#str}} flagplace, mod_selfselectadvanced {{/str}}
                    </a>
                </li>
            {{/groupless}}
        </ul>
    {{/hasgroupless}}
    {{^hasgroupless}}
        <p class="text-muted">{{#str}} flagnonegroupless, mod_selfselectadvanced {{/str}}</p>
    {{/hasgroupless}}

    <h4>{{#str}} flagmissingattrs, mod_selfselectadvanced {{/str}}</h4>
    {{#hasmissingattrs}}
        {{{missingattrstable}}}
    {{/hasmissingattrs}}
    {{^hasmissingattrs}}
        <p class="text-muted">{{#str}} flagnonemissing, mod_selfselectadvanced {{/str}}</p>
    {{/hasmissingattrs}}

    <h4>{{#str}} flaganomalies, mod_selfselectadvanced {{/str}}</h4>
    {{#hasanomalies}}
        {{{anomaliestable}}}
    {{/hasanomalies}}
    {{^hasanomalies}}
        <p class="text-muted">{{#str}} flagnoneanomalies, mod_selfselectadvanced {{/str}}</p>
    {{/hasanomalies}}

    <a href="{{backurl}}" class="btn btn-secondary">{{#str}} back {{/str}}</a>
</div>
