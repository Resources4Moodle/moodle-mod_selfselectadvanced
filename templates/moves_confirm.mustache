{{!
    @template mod_selfselectadvanced/moves_confirm

    Confirmation step for a commit that overrides composition rules
    (decision 6): every overridden rule is named with the figures that
    refused it, and a reason is required before the commit proceeds.

    Names only - never an email address or a phone number.

    Context variables required for this template:
    * rows - one entry per move that carries an override
    * rows.rules - the overridden rule codes with their figures
    * selected - the re-posted selection
    * actionurl - the moves page
    * cmid - course module id
    * sesskey - session key
    * cancelurl - back to the list

    Example context (json):
    {
        "rows": [
            {"user": "Sam One", "source": "Team A", "target": "Team B",
             "rules": [{"rule": "L2", "figures": "3 members after the move, maximum 2"}]}
        ],
        "selected": [{"moveid": 7}],
        "actionurl": "https://example.com/mod/selfselectadvanced/moves.php?id=1",
        "cmid": 1,
        "sesskey": "abc",
        "cancelurl": "https://example.com/mod/selfselectadvanced/moves.php?id=1"
    }
}}
<div class="selfselectadvanced-moveconfirm">
    <h3>{{#str}} moveoverrideconfirm, mod_selfselectadvanced {{/str}}</h3>
    <p class="text-muted">{{#str}} moveoverrideconfirm_help, mod_selfselectadvanced {{/str}}</p>

    <div class="table-responsive">
        <table class="table generaltable">
            <thead>
                <tr>
                    <th scope="col">{{#str}} movestudent, mod_selfselectadvanced {{/str}}</th>
                    <th scope="col">{{#str}} movefrom, mod_selfselectadvanced {{/str}}</th>
                    <th scope="col">{{#str}} moveto, mod_selfselectadvanced {{/str}}</th>
                    <th scope="col">{{#str}} movevalidation, mod_selfselectadvanced {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>{{user}}</td>
                        <td>{{source}}</td>
                        <td>{{target}}</td>
                        <td>
                            {{#rules}}
                                <div class="ssa-overriddenrule">
                                    <span class="badge bg-warning text-dark">{{rule}}</span>
                                    <small class="d-block text-muted">{{figures}}</small>
                                </div>
                            {{/rules}}
                        </td>
                    </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>

    <form method="post" action="{{actionurl}}">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="action" value="commit">
        <input type="hidden" name="confirmoverrides" value="1">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#selected}}
            <input type="hidden" name="selected[]" value="{{moveid}}">
        {{/selected}}
        <div class="mb-2">
            <label for="ssa-overridereason" class="form-label">
                {{#str}} moveoverridereason, mod_selfselectadvanced {{/str}}
            </label>
            <textarea class="form-control" id="ssa-overridereason" name="overridereason" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">
            {{#str}} movecommitoverride, mod_selfselectadvanced {{/str}}
        </button>
        <a href="{{cancelurl}}" class="btn btn-secondary ms-2">{{#str}} cancel {{/str}}</a>
    </form>
</div>
