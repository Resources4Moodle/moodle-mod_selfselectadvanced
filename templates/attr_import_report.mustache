{{!
    @template mod_selfselectadvanced/attr_import_report

    CSV import validation report: dry-run preview or committed result.

    Context variables required for this template:
    * committed - whether the import has been written
    * report - counts object (total, created, updated)

    Example context (json):
    {
        "committed": false,
        "report": {"total": 10, "created": 6, "updated": 2, "warnings": ["Line 4: name mismatch"], "rejected": ["Line 7: no such user"]},
        "haswarnings": true,
        "hasrejected": true,
        "headererror": null,
        "canconfirm": true,
        "importid": 123,
        "sesskey": "abc",
        "actionurl": "https://example.com/mod/selfselectadvanced/attributes.php",
        "backurl": "https://example.com/mod/selfselectadvanced/attributes.php"
    }
}}
<div class="selfselectadvanced-importreport">
    {{#headererror}}
        <div class="alert alert-danger">{{headererror}}</div>
    {{/headererror}}
    {{^headererror}}
        <h4>
            {{#committed}}{{#str}} csvcommitted, mod_selfselectadvanced {{/str}}{{/committed}}
            {{^committed}}{{#str}} csvpreviewheading, mod_selfselectadvanced {{/str}}{{/committed}}
        </h4>
        <ul>
            <li>{{#str}} csvtotal, mod_selfselectadvanced, {{report.total}} {{/str}}</li>
            <li>{{#str}} csvcreated, mod_selfselectadvanced, {{report.created}} {{/str}}</li>
            <li>{{#str}} csvupdated, mod_selfselectadvanced, {{report.updated}} {{/str}}</li>
        </ul>

        {{#hasrejected}}
            <h5>{{#str}} csvrejected, mod_selfselectadvanced {{/str}}</h5>
            <ul class="text-danger">
                {{#report.rejected}}<li>{{.}}</li>{{/report.rejected}}
            </ul>
        {{/hasrejected}}
        {{#haswarnings}}
            <h5>{{#str}} csvwarnings, mod_selfselectadvanced {{/str}}</h5>
            <ul>
                {{#report.warnings}}<li>{{.}}</li>{{/report.warnings}}
            </ul>
        {{/haswarnings}}

        {{#canconfirm}}
            {{#modesummary}}<p class="selfselectadvanced-modesummary"><strong>{{modesummary}}</strong></p>{{/modesummary}}
            <form method="post" action="{{actionurl}}" class="mb-3">
                <input type="hidden" name="action" value="confirmimport">
                <input type="hidden" name="importid" value="{{importid}}">
                <input type="hidden" name="updatemode" value="{{updatemode}}">
                <input type="hidden" name="defaultsjson" value="{{defaultsjson}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-primary">
                    {{#str}} csvconfirm, mod_selfselectadvanced {{/str}}
                </button>
            </form>
        {{/canconfirm}}
    {{/headererror}}

    <a href="{{backurl}}" class="btn btn-secondary">{{#str}} back {{/str}}</a>
</div>
