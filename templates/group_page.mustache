    {{#js}}
    (function() {
        var key = 'ssa-leadertab-' + {{groupid}};
        var stored = null;
        try { stored = window.sessionStorage.getItem(key); } catch (e) { /* private mode */ }
        var wanted = window.location.hash || stored;
        if (wanted) {
            var link = document.querySelector('.selfselectadvanced-leadertabs a[href="' + wanted + '"]');
            // Bootstrap's data API switches the pane on click; a
            // simulated click avoids depending on any plugin API.
            if (link && !link.classList.contains('active')) { link.click(); }
        }
        document.querySelectorAll('.selfselectadvanced-leadertabs a[data-bs-toggle="tab"]').forEach(function(tab) {
            tab.addEventListener('shown.bs.tab', function(e) {
                try { window.sessionStorage.setItem(key, e.target.getAttribute('href')); } catch (e2) { /* ditto */ }
            });
        });
    })();
    {{/js}}

