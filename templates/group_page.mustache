{{!
    @template mod_selfselectadvanced/group_page

    One group: identity, roster, seat position, invitations and actions.

    Context variables required for this template:
    * pluginuid - plugin-scoped unique group id
    * name - group name
    * statelabel - localised state
    * sesskey - session key for the action forms

    Example context (json):
    {
        "pluginuid": "SSA-C101-0001",
        "name": "Team Alpha",
        "title": "Pendulum study",
        "brief": "<p>We will study pendulums.</p>",
        "statelabel": "Forming",
        "seatsummary": "2 of 6 seats filled, 1 invitation pending",
        "minsizenote": "Minimum group size: 4 confirmed members",
        "hasroster": true,
        "showmobilecaution": false,
        "rosterhead": [{"url": "#", "label": "First name", "ascending": false, "descending": false}],
        "rosterfilter": "",
        "rosterfilteraction": "https://example.com/mod/selfselectadvanced/group.php",
        "groupid": 1,
        "roster": [
            {"fullname": "Alice Lead", "firstname": "Alice", "lastname": "Lead", "isleader": true,
             "dims": [{"value": "Computer"}]},
            {"fullname": "Bob Member", "firstname": "Bob", "lastname": "Member", "isleader": false,
             "dims": [{"value": "Science"}]}
        ],
        "isleader": true,
        "caninvite": true,
        "inviteformhtml": "",
        "invitedisabledreason": "",
        "haspendinginvites": true,
        "pendinginvites": [
            {"memberid": 3, "fullname": "Cara Invitee", "invitedon": "Wednesday, 22 July", "declined": false}
        ],
        "showrespond": false,
        "showjoinpanel": true,
        "joinallurl": "https://example.com/mod/selfselectadvanced/joinrequest.php?id=1&tab=answer",
        "joinrows": [
            {
                "requestid": 9,
                "fullname": "Nina Three",
                "reason": "Closer to my programme",
                "department": "Science",
                "subdepartment": "Physics",
                "hasdepartment": true,
                "hassubdepartment": true,
                "noattributes": false,
                "fits": true,
                "caution": "",
                "haswarnings": true,
                "warnings": [
                    {"text": "2 of 2 seats for Science are confirmed; 1 more is invited, so this request would make 3."}
                ],
                "seatline": "Would fill the seat for Physics",
                "leavesline": "Would leave Team Blue.",
                "asked": "Wednesday, 22 July"
            }
        ],
        "eoienabled": true,
        "listed": true,
        "showeoilist": false,
        "showeoiunlist": true,
        "showeoipanel": true,
        "caneoirespond": true,
        "eoiassigned": false,
        "eoiinterestline": "2 guide(s) have shown interest in this team.",
        "haseoirows": true,
        "showeoiempty": false,
        "showeoisequentialnote": true,
        "eoirows": [
            {
                "eoiid": 5,
                "guidename": "Gina Guide",
                "remarks": "<p>Happy to help with this topic.</p>",
                "timecreated": "Wednesday, 22 July",
                "statuslabel": "Awaiting the leader",
                "ispending": true,
                "accepturl": "https://example.com/mod/selfselectadvanced/group.php?...&decision=accept",
                "rejecturl": "https://example.com/mod/selfselectadvanced/group.php?...&decision=reject"
            }
        ],
        "sesskey": "abc",
        "actionurl": "https://example.com/mod/selfselectadvanced/group.php",
        "cmid": 1,
        "groupid": 1,
        "candelete": true,
        "deleteurl": "https://example.com/mod/selfselectadvanced/group.php?id=1&g=1&action=delete",
        "backurl": "https://example.com/mod/selfselectadvanced/view.php?id=1"
    }
}}
<div class="selfselectadvanced-grouppage">
    <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
        <div>
            <h3 class="mb-0">{{name}}</h3>
            <span class="text-muted small">{{pluginuid}}</span>
        </div>
        <span class="badge bg-info text-dark">{{statelabel}}</span>
    </div>

    <h4>{{title}}</h4>
    <div class="selfselectadvanced-brief mb-3">{{{brief}}}</div>

    <p>
        <strong>{{seatsummary}}</strong>
        <span class="d-block text-muted small">{{minsizenote}}</span>
        {{#hasguide}}
            <span class="d-block small">{{#str}} guidelabel, mod_selfselectadvanced, {{guidename}} {{/str}}</span>
            {{! Decision 88: where to find them, beside who they are. }}
            {{#guideseat}}<span class="d-block small text-muted">{{guideseat}}</span>{{/guideseat}}
        {{/hasguide}}
    </p>

    {{#quota}}{{> mod_selfselectadvanced/quota_panel }}{{/quota}}

    {{#returncomment}}
        <div class="alert alert-warning selfselectadvanced-returncomment">
            <strong>{{#str}} returnedwithcomment, mod_selfselectadvanced {{/str}}</strong>
            <p class="mb-0">{{{returncomment}}}</p>
        </div>
    {{/returncomment}}

    {{#disbandlive}}
        <div class="alert alert-warning selfselectadvanced-disbandbanner">
            <strong>{{#str}} disbandpending, mod_selfselectadvanced {{/str}}</strong>
            <div class="mt-1">{{{disbandreason}}}</div>
            {{#showselfleave}}
                <form method="post" action="{{actionurl}}" class="mt-2">
                    <input type="hidden" name="id" value="{{cmid}}">
                    <input type="hidden" name="g" value="{{groupid}}">
                    <input type="hidden" name="action" value="selfleave">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn btn-warning btn-sm">
                        {{#str}} disbandleave, mod_selfselectadvanced {{/str}}
                    </button>
                </form>
            {{/showselfleave}}
            {{#showdisbandcancel}}
                <form method="post" action="{{actionurl}}" class="mt-2">
                    <input type="hidden" name="id" value="{{cmid}}">
                    <input type="hidden" name="g" value="{{groupid}}">
                    <input type="hidden" name="action" value="canceldisband">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        {{#str}} disbandcancel, mod_selfselectadvanced {{/str}}
                    </button>
                </form>
            {{/showdisbandcancel}}
        </div>
    {{/disbandlive}}

    {{#eoiassigned}}
        <div class="alert alert-success selfselectadvanced-eoiassigned">
            {{#str}} eoiassignedguide, mod_selfselectadvanced, {{guidename}} {{/str}}
        </div>
    {{/eoiassigned}}

    {{#eoienabled}}
        <div class="selfselectadvanced-eoi mb-3">
            <h4>{{#str}} eoisettings, mod_selfselectadvanced {{/str}}</h4>
            {{#listed}}
                <span class="badge bg-success">{{#str}} eoilistedbadge, mod_selfselectadvanced {{/str}}</span>
                {{#showeoiunlist}}
                    <form method="post" action="{{actionurl}}" class="d-inline ms-2">
                        <input type="hidden" name="id" value="{{cmid}}">
                        <input type="hidden" name="g" value="{{groupid}}">
                        <input type="hidden" name="action" value="eoiunlist">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            {{#str}} eoiunlisttoggle, mod_selfselectadvanced {{/str}}
                        </button>
                    </form>
                {{/showeoiunlist}}
            {{/listed}}
            {{^listed}}
                {{#showeoilist}}
                    <form method="post" action="{{actionurl}}" class="d-inline">
                        <input type="hidden" name="id" value="{{cmid}}">
                        <input type="hidden" name="g" value="{{groupid}}">
                        <input type="hidden" name="action" value="eoilist">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            {{#str}} eoilisttoggle, mod_selfselectadvanced {{/str}}
                        </button>
                    </form>
                {{/showeoilist}}
            {{/listed}}

            {{#eoiinterestline}}
                <p class="mb-1 mt-2">{{eoiinterestline}}</p>
            {{/eoiinterestline}}

            {{#showeoipanel}}
                {{#showeoisequentialnote}}
                    <p class="text-muted small mb-1 mt-2">{{#str}} eoisequentialnote, mod_selfselectadvanced {{/str}}</p>
                {{/showeoisequentialnote}}
                {{#haseoirows}}
                    <ul class="list-group mt-2 selfselectadvanced-eoirows">
                        {{#eoirows}}
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start flex-wrap">
                                    <div>
                                        <strong>{{guidename}}</strong>
                                        <span class="badge bg-secondary ms-2">{{statuslabel}}</span>
                                        <span class="d-block text-muted small">{{timecreated}}</span>
                                        {{#remarks}}<div class="small mt-1">{{{remarks}}}</div>{{/remarks}}
                                    </div>
                                    {{#ispending}}
                                        {{#caneoirespond}}
                                            <div class="mt-1">
                                                <a href="{{accepturl}}" class="btn btn-primary btn-sm">
                                                    {{#str}} accept, mod_selfselectadvanced {{/str}}
                                                </a>
                                                <a href="{{rejecturl}}" class="btn btn-secondary btn-sm ms-1">
                                                    {{#str}} decline, mod_selfselectadvanced {{/str}}
                                                </a>
                                            </div>
                                        {{/caneoirespond}}
                                        {{#eoiblockedreason}}
                                            <div class="mt-1 text-muted small">{{eoiblockedreason}}</div>
                                        {{/eoiblockedreason}}
                                    {{/ispending}}
                                </div>
                            </li>
                        {{/eoirows}}
                    </ul>
                {{/haseoirows}}
                {{#showeoiempty}}
                    <p class="text-muted mb-0 mt-2">{{#str}} eoinointerests, mod_selfselectadvanced {{/str}}</p>
                {{/showeoiempty}}
            {{/showeoipanel}}
        </div>
    {{/eoienabled}}

    {{#canrequestleave}}
        <form method="post" action="{{actionurl}}" class="d-inline mb-2">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="g" value="{{groupid}}">
            <input type="hidden" name="action" value="requestleave">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                {{#str}} requestleave, mod_selfselectadvanced {{/str}}
            </button>
        </form>
    {{/canrequestleave}}
    {{! Decision 83: a confirmed member who cannot ask to leave right now sees }}
    {{! the control with the reason, never a blank space. Somebody who is not a }}
    {{! member of this group sees nothing, because there is nothing to explain. }}
    {{#leavereason}}
        <button type="button" class="btn btn-outline-secondary btn-sm mb-2" disabled>
            {{#str}} requestleave, mod_selfselectadvanced {{/str}}
        </button>
        <span class="ms-1 text-muted small">{{leavereason}}</span>
    {{/leavereason}}
    {{#hasleaverequests}}
        <div class="alert alert-warning selfselectadvanced-leaverequests">
            {{#leaverequests}}
                <form method="post" action="{{actionurl}}" class="d-inline me-2">
                    <input type="hidden" name="id" value="{{cmid}}">
                    <input type="hidden" name="g" value="{{groupid}}">
                    <input type="hidden" name="action" value="confirmleave">
                    <input type="hidden" name="m" value="{{memberid}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    {{fullname}}:
                    <button type="submit" class="btn btn-secondary btn-sm">
                        {{#str}} confirmleave, mod_selfselectadvanced {{/str}}
                    </button>
                </form>
            {{/leaverequests}}
        </div>
    {{/hasleaverequests}}

    {{#showjoinpanel}}
        <div class="selfselectadvanced-joinpanel card mb-3">
            <div class="card-body">
                <h4 class="card-title">{{#str}} joinpanelheading, mod_selfselectadvanced {{/str}}</h4>
                <p class="text-muted small">{{#str}} joinpanelintro, mod_selfselectadvanced {{/str}}</p>
                <ul class="list-group selfselectadvanced-joinrows">
                    {{#joinrows}}
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <strong>{{fullname}}</strong>
                                    <span class="d-block small">
                                        {{#hasdepartment}}
                                            {{#str}} attrdepartment, mod_selfselectadvanced {{/str}}: {{department}}
                                        {{/hasdepartment}}
                                        {{#hassubdepartment}}
                                            <span class="ms-2">
                                                {{#str}} attrsubdepartment, mod_selfselectadvanced {{/str}}: {{subdepartment}}
                                            </span>
                                        {{/hassubdepartment}}
                                        {{#noattributes}}
                                            <span class="text-muted">{{#str}} attrsmissing, mod_selfselectadvanced {{/str}}</span>
                                        {{/noattributes}}
                                    </span>
                                    <span class="d-block text-muted small">{{asked}}</span>
                                    <div class="mt-1">{{reason}}</div>
                                    {{#fits}}
                                        <div class="text-success small">{{#str}} joinfitok, mod_selfselectadvanced {{/str}}</div>
                                    {{/fits}}
                                    {{^fits}}
                                        <div class="text-warning small">
                                            <strong>{{#str}} joinfitcaution, mod_selfselectadvanced {{/str}}</strong> {{caution}}
                                        </div>
                                    {{/fits}}
                                    {{#haswarnings}}
                                        {{#warnings}}
                                            <div class="text-warning small">{{text}}</div>
                                        {{/warnings}}
                                    {{/haswarnings}}
                                    {{#cannotaccept}}
                                        <div class="text-danger small">{{hardreason}}</div>
                                    {{/cannotaccept}}
                                    {{#seatline}}<div class="small">{{seatline}}</div>{{/seatline}}
                                    <div class="small text-muted">{{leavesline}}</div>
                                </div>
                                <form method="post" action="{{actionurl}}" class="d-flex flex-wrap gap-1 align-items-center">
                                    <input type="hidden" name="id" value="{{cmid}}">
                                    <input type="hidden" name="g" value="{{groupid}}">
                                    <input type="hidden" name="action" value="joinrespond">
                                    <input type="hidden" name="r" value="{{requestid}}">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    {{#confirmacceptrequired}}
                                        <input type="hidden" name="confirmaccept" value="1">
                                    {{/confirmacceptrequired}}
                                    <label class="visually-hidden" for="ssajoinnote-{{requestid}}">
                                        {{#str}} joinnotehint, mod_selfselectadvanced {{/str}}
                                    </label>
                                    <input type="text" name="note" id="ssajoinnote-{{requestid}}" size="20"
                                        class="form-control form-control-sm w-auto"
                                        placeholder="{{#str}} joinnotehint, mod_selfselectadvanced {{/str}}">
                                    <button type="submit" name="decision" value="accept" class="btn btn-primary btn-sm"
                                        {{#cannotaccept}}disabled title="{{hardreason}}"{{/cannotaccept}}
                                        {{#confirmacceptrequired}}data-ssaconfirm="{{confirmacceptmessage}}"
                                        onclick="return confirm(this.dataset.ssaconfirm);"{{/confirmacceptrequired}}>
                                        {{#str}} joinaccept, mod_selfselectadvanced {{/str}}
                                    </button>
                                    <button type="submit" name="decision" value="decline" class="btn btn-outline-warning btn-sm">
                                        {{#str}} joindecline, mod_selfselectadvanced {{/str}}
                                    </button>
                                </form>
                            </div>
                        </li>
                    {{/joinrows}}
                </ul>
                <a href="{{joinallurl}}" class="small d-inline-block mt-2">
                    {{#str}} joinpanelallrequests, mod_selfselectadvanced {{/str}}
                </a>
            </div>
        </div>
    {{/showjoinpanel}}
    {{! Decision 83: a leader who cannot answer the queue is told it exists }}
    {{! and why they cannot, instead of being shown a page with no queue.   }}
    {{#eoitruncated}}
        <p class="small text-muted mb-2">{{eoitruncated}}</p>
    {{/eoitruncated}}
    {{#joinblockedreason}}
        <div class="alert alert-warning selfselectadvanced-joinblocked" role="status">{{joinblockedreason}}</div>
    {{/joinblockedreason}}

    {{! Decision 83: the PROMPT is a fact and belongs to the invitee whatever }}
    {{! their capability; only the buttons are gated.                         }}
    {{#respondblocked}}
        <div class="selfselectadvanced-respond alert alert-info">
            <span>{{#str}} respondprompt, mod_selfselectadvanced {{/str}}</span>
        </div>
    {{/respondblocked}}
    {{#showrespond}}
        <div class="selfselectadvanced-respond alert alert-info d-flex align-items-center flex-wrap gap-2">
            <span class="me-2">{{#str}} respondprompt, mod_selfselectadvanced {{/str}}</span>
            <form method="post" action="{{actionurl}}" class="d-inline">
                <input type="hidden" name="id" value="{{cmid}}">
                <input type="hidden" name="g" value="{{groupid}}">
                <input type="hidden" name="action" value="accept">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-primary btn-sm">{{#str}} accept, mod_selfselectadvanced {{/str}}</button>
            </form>
            <form method="post" action="{{actionurl}}" class="d-inline">
                <input type="hidden" name="id" value="{{cmid}}">
                <input type="hidden" name="g" value="{{groupid}}">
                <input type="hidden" name="action" value="decline">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-secondary btn-sm">{{#str}} decline, mod_selfselectadvanced {{/str}}</button>
            </form>
        </div>
    {{/showrespond}}

    <h4>{{#str}} roster, mod_selfselectadvanced {{/str}}</h4>
    {{! The filter form is gated on hasanyroster, NOT hasroster: a filter that }}
    {{! matches nobody must not take away the box that has to be cleared.      }}
    {{#hasanyroster}}
        <form method="get" action="{{rosterfilteraction}}" class="d-flex flex-wrap gap-2 mb-2">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="g" value="{{groupid}}">
            <input type="text" name="rq" value="{{rosterfilter}}" class="form-control form-control-sm w-auto"
                placeholder="{{#str}} flaggedfilter, mod_selfselectadvanced {{/str}}">
            <button type="submit" class="btn btn-secondary btn-sm">{{#str}} filter, core {{/str}}</button>
        </form>
    {{/hasanyroster}}
    {{#rosternomatch}}
        <div class="alert alert-info" role="status">{{rosternomatch}}</div>
    {{/rosternomatch}}
    {{#hasroster}}
        <div class="table-responsive">
            <table class="generaltable selfselectadvanced-roster">
                <thead>
                    <tr>
                        {{#rosterhead}}
                            <th scope="col">
                                <a href="{{url}}">{{label}}</a>{{#ascending}} &#9650;{{/ascending}}{{#descending}} &#9660;{{/descending}}
                            </th>
                        {{/rosterhead}}
                        <th scope="col">{{#str}} role, core {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#roster}}
                        <tr>
                            <td>{{firstname}}</td>
                            <td>{{lastname}}</td>
                            {{#dims}}
                                <td>{{value}}</td>
                            {{/dims}}
                            <td>
                                {{#isleader}}
                                    <span class="badge bg-primary">{{#str}} leader, mod_selfselectadvanced {{/str}}</span>
                                {{/isleader}}
                            </td>
                        </tr>
                    {{/roster}}
                </tbody>
            </table>
        </div>
        {{#showmobilecaution}}
            <p class="text-muted small">{{#str}} mobilecaution, mod_selfselectadvanced {{/str}}</p>
        {{/showmobilecaution}}
    {{/hasroster}}

    {{#haspendinginvites}}
        <h4>{{#str}} pendinginvitations, mod_selfselectadvanced {{/str}}</h4>
        <ul class="list-group mb-3 selfselectadvanced-pendinginvites">
            {{#pendinginvites}}
                <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                    <span>
                        {{fullname}}
                        <span class="text-muted small ms-2">{{invitedon}}</span>
                        {{#declined}}
                            <span class="badge bg-secondary ms-2">{{#str}} invitedeclinedlabel, mod_selfselectadvanced {{/str}}</span>
                        {{/declined}}
                        <span class="d-block small">
                            {{#hasdepartment}}
                                {{#str}} attrdepartment, mod_selfselectadvanced {{/str}}: {{department}}
                            {{/hasdepartment}}
                            {{#hassubdepartment}}
                                <span class="ms-2">
                                    {{#str}} attrsubdepartment, mod_selfselectadvanced {{/str}}: {{subdepartment}}
                                </span>
                            {{/hassubdepartment}}
                            {{#noattributes}}
                                <span class="text-muted">{{#str}} attrsmissing, mod_selfselectadvanced {{/str}}</span>
                            {{/noattributes}}
                        </span>
                        {{#blocked}}
                            <span class="d-block small text-danger selfselectadvanced-invitation-blocked">
                                {{blockedreason}}
                            </span>
                        {{/blocked}}
                    </span>
                    {{^declined}}
                    {{#isleader}}
                        <form method="post" action="{{actionurl}}" class="d-inline">
                            <input type="hidden" name="id" value="{{cmid}}">
                            <input type="hidden" name="g" value="{{groupid}}">
                            <input type="hidden" name="action" value="withdraw">
                            <input type="hidden" name="m" value="{{memberid}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                {{#str}} withdraw, mod_selfselectadvanced {{/str}}
                            </button>
                        </form>
                    {{/isleader}}
                    {{/declined}}
                </li>
            {{/pendinginvites}}
        </ul>
    {{/haspendinginvites}}
    {{! Decision 90: a cap nobody is told about reads as the whole record. }}
    {{#declinedtruncated}}
        <p class="small text-muted mb-2">{{declinedtruncated}}</p>
    {{/declinedtruncated}}

    {{#showleadertabs}}
    <ul class="nav nav-tabs mt-4 selfselectadvanced-leadertabs" role="tablist">
        {{#tabinvite}}
            <li class="nav-item" role="presentation">
                <a class="nav-link {{#invitetabactive}}active{{/invitetabactive}}" id="ssa-leadertab-invite"
                    data-bs-toggle="tab" href="#ssa-leaderpane-invite" role="tab"
                    aria-controls="ssa-leaderpane-invite"
                    aria-selected="{{#invitetabactive}}true{{/invitetabactive}}{{^invitetabactive}}false{{/invitetabactive}}">
                    {{#str}} invitemembers, mod_selfselectadvanced {{/str}}
                </a>
            </li>
        {{/tabinvite}}
        {{#tabsuccession}}
            <li class="nav-item" role="presentation">
                <a class="nav-link {{#successiontabactive}}active{{/successiontabactive}}" id="ssa-leadertab-succession"
                    data-bs-toggle="tab" href="#ssa-leaderpane-succession" role="tab"
                    aria-controls="ssa-leaderpane-succession"
                    aria-selected="{{#successiontabactive}}true{{/successiontabactive}}{{^successiontabactive}}false{{/successiontabactive}}">
                    {{#str}} succession, mod_selfselectadvanced {{/str}}
                    {{#hasnomination}}<span class="badge bg-danger ms-1">1</span>{{/hasnomination}}
                </a>
            </li>
        {{/tabsuccession}}
        {{#tabsubmit}}
            <li class="nav-item" role="presentation">
                <a class="nav-link {{#submittabactive}}active{{/submittabactive}}" id="ssa-leadertab-submit"
                    data-bs-toggle="tab" href="#ssa-leaderpane-submit" role="tab"
                    aria-controls="ssa-leaderpane-submit"
                    aria-selected="{{#submittabactive}}true{{/submittabactive}}{{^submittabactive}}false{{/submittabactive}}">
                    {{#str}} submittoguide, mod_selfselectadvanced {{/str}}
                </a>
            </li>
        {{/tabsubmit}}
    </ul>
    {{! With JavaScript off, Bootstrap cannot switch panes: every pane
        renders stacked instead - which is also what the non-JS Behat
        driver and a JS-less user get, the exact pre-tab page. }}
    <noscript>
        <style>
            .selfselectadvanced-leadertabs { display: none; }
            .selfselectadvanced-leaderpanes .tab-pane { display: block !important; opacity: 1; }
        </style>
    </noscript>
    <div class="tab-content pt-3 selfselectadvanced-leaderpanes">
        {{#tabinvite}}
        <div class="tab-pane fade {{#invitetabactive}}show active{{/invitetabactive}}" id="ssa-leaderpane-invite"
            role="tabpanel" aria-labelledby="ssa-leadertab-invite">
    {{#caninvite}}
        <h4>{{#str}} invitemembers, mod_selfselectadvanced {{/str}}</h4>
        {{{inviteformhtml}}}
    {{/caninvite}}
