{{!
    @template mod_selfselectadvanced/landing

    Capability-routed landing page: student panels and staff group list.

    Context variables required for this template:
    * isstudent - whether to show the student area
    * isstaff - whether to show the all-groups area
    * privacystatement - the per-activity privacy notice, worded from the
      CURRENT contact-privacy setting; always present (decisions 91/93)
    * privacynumbernote - where to correct the number itself (decision 92)
    * showconsent - whether the share/revoke control appears INSIDE the
      privacy panel (a userattr record with a non-empty mobile exists)
    * showguidepanel - whether the viewer holds :guide, and so is shown
      their own decision window before anything else on the page
    * guidepanel - the guide_panel context (null when not a guide)
    * showjoinlink - whether the viewer may open joinrequest.php at all

    Example context (json):
    {
        "showguidepanel": false,
        "guidepanel": null,
        "showjoinlink": true,
        "studentapproachnotice": "",
        "iscoordinator": false,
        "ticketsurl": "https://example.com/mod/selfselectadvanced/coordinator.php?id=1",
        "showconsent": true,
        "consentgranted": false,
        "privacystatement": "Contact privacy is ON for this activity. Your email address is not shown to other participants anywhere in this activity.",
        "privacynumbernote": "This activity does not hold your contact details of its own - they come from your institutional record.",
        "consentstatus": "Your mobile number is hidden. While this activity is protecting contact details, only an editing teacher, a manager or a site administrator can still read it.",
        "consentbuttonlabel": "Share my number",
        "consentaction": "grant",
        "consentactionurl": "https://example.com/mod/selfselectadvanced/view.php?id=1",
        "isstudent": true,
        "leadcounter": "You lead 1 of 2 groups",
        "membercounter": "You are a member of 1 of 3 groups",
        "showcreate": true,
        "cancreate": true,
        "createreason": null,
        "createurl": "https://example.com/mod/selfselectadvanced/groupedit.php?id=1",
        "hasmygroups": true,
        "mygroups": [
            {
                "id": 1,
                "pluginuid": "SSA-C101-0001",
                "name": "Team Alpha",
                "title": "Pendulum study",
                "statelabel": "Forming",
                "seatsummary": "2 of 6 seats filled, 1 invitation pending",
                "url": "https://example.com/mod/selfselectadvanced/group.php?id=1&g=1"
            }
        ],
        "hasmyinvitations": false,
        "myinvitations": [],
        "mayrespond": true,
        "isstaff": false,
        "hasallgroups": false,
        "allgroups": [],
        "allgroupstruncated": false,
        "canseeallgroups": true,
        "allgroupsshowingtext": "",
        "manageallurl": "https://example.com/mod/selfselectadvanced/manage.php?id=1"
    }
}}
<div class="selfselectadvanced-landing">
{{#showguidepanel}}
    {{#guidepanel}}
        {{> mod_selfselectadvanced/guide_panel }}
    {{/guidepanel}}
{{/showguidepanel}}
{{#studentapproachnotice}}
    <div class="selfselectadvanced-approach alert alert-info mb-3">{{studentapproachnotice}}</div>
{{/studentapproachnotice}}
{{! Decisions 91/92/93: this panel is UNCONDITIONAL. Before 1.20.30 only the }}
{{! consent row existed and it rendered solely for people who happened to    }}
{{! have a number on record, so the better-protected student was told less   }}
{{! than the exposed one and the silence looked like a bug.                  }}
<div class="selfselectadvanced-privacy alert alert-light border mb-3">
    <h5 class="h6 mb-1">{{#str}} privacypanelheading, mod_selfselectadvanced {{/str}}</h5>
    <p class="mb-1 small">{{privacystatement}}</p>
    <p class="mb-0 small text-muted">{{privacynumbernote}}</p>
    {{#showconsent}}
        <div class="selfselectadvanced-consent d-flex justify-content-between align-items-center flex-wrap mt-2 pt-2 border-top">
            <span class="small">{{consentstatus}}</span>
            <form method="post" action="{{consentactionurl}}" class="d-inline ms-2">
                <input type="hidden" name="id" value="{{cmid}}">
                <input type="hidden" name="consentaction" value="{{consentaction}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-outline-secondary btn-sm">{{consentbuttonlabel}}</button>
            </form>
        </div>
    {{/showconsent}}
</div>
{{#isstudent}}
    <div class="selfselectadvanced-counters mb-3">
        <span class="badge bg-light text-body border me-2">{{leadcounter}}</span>
        <span class="badge bg-light text-body border">{{membercounter}}</span>
    </div>

    {{#showcreate}}
        <div class="mb-3">
            {{#cancreate}}
                <a href="{{createurl}}" class="btn btn-primary">{{#str}} creategroup, mod_selfselectadvanced {{/str}}</a>
            {{/cancreate}}
            {{^cancreate}}
                <button type="button" class="btn btn-secondary" disabled aria-disabled="true">
                    {{#str}} creategroup, mod_selfselectadvanced {{/str}}
                </button>
                <span class="ms-2 text-muted">{{createreason}}</span>
            {{/cancreate}}
        </div>
    {{/showcreate}}

    <h3>{{#str}} mygroups, mod_selfselectadvanced {{/str}}</h3>
    {{#hasmygroups}}
        <ul class="list-group mb-4 selfselectadvanced-mygroups">
            {{#mygroups}}
                <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                    <span>
                        <a href="{{url}}">{{name}}</a>
                        <span class="text-muted small ms-2">{{pluginuid}}</span>
                        <span class="d-block small">{{title}}</span>
                    </span>
                    <span class="text-end">
                        <span class="badge bg-info text-dark">{{statelabel}}</span>
                        <span class="d-block small text-muted">{{seatsummary}}</span>
                    </span>
                </li>
            {{/mygroups}}
        </ul>
    {{/hasmygroups}}
    {{^hasmygroups}}
        <p class="text-muted">{{#str}} nogroupsyet, mod_selfselectadvanced {{/str}}</p>
    {{/hasmygroups}}

    <h3>{{#str}} myinvitations, mod_selfselectadvanced {{/str}}</h3>
    {{#hasmyinvitations}}
        <ul class="list-group mb-4 selfselectadvanced-myinvitations">
            {{#myinvitations}}
                <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                    <span>
                        <a href="{{url}}">{{name}}</a>
                        <span class="text-muted small ms-2">{{pluginuid}}</span>
                        <span class="d-block small">{{title}}</span>
                        <span class="d-block small text-muted">{{seatsummary}}</span>
                        {{#blocked}}
                            <span class="d-block small text-danger selfselectadvanced-invitation-blocked">
                                {{blockedreason}}
                            </span>
                        {{/blocked}}
                    </span>
                    <span class="text-end">
                        {{#mayrespond}}
                        <form method="post" action="{{actionurl}}" class="d-inline">
                            <input type="hidden" name="id" value="{{cmid}}">
                            <input type="hidden" name="g" value="{{id}}">
                            <input type="hidden" name="action" value="accept">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <button type="submit" class="btn btn-primary btn-sm"
                                {{#blocked}}disabled title="{{blockedreason}}"{{/blocked}}>
                                {{#str}} accept, mod_selfselectadvanced {{/str}}
                            </button>
                        </form>
                        <form method="post" action="{{actionurl}}" class="d-inline">
                            <input type="hidden" name="id" value="{{cmid}}">
                            <input type="hidden" name="g" value="{{id}}">
                            <input type="hidden" name="action" value="decline">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <button type="submit" class="btn btn-secondary btn-sm">
                                {{#str}} decline, mod_selfselectadvanced {{/str}}
                            </button>
                        </form>
                        {{/mayrespond}}
                        {{! Decision 83: :respond prohibited hides the buttons, but the }}
                        {{! row must not then read as though the rule above were the    }}
                        {{! only obstacle - the invitation is still listed and this      }}
                        {{! says who to ask.                                            }}
                        {{^mayrespond}}
                            <span class="d-block small text-muted">
                                {{#str}} respondnotpermitted, mod_selfselectadvanced {{/str}}
                            </span>
                        {{/mayrespond}}
                    </span>
                </li>
            {{/myinvitations}}
        </ul>
    {{/hasmyinvitations}}
    {{^hasmyinvitations}}
        <p class="text-muted">{{#str}} noinvitations, mod_selfselectadvanced {{/str}}</p>
    {{/hasmyinvitations}}

    {{#hasmynominations}}
        <h3>{{#str}} mynominations, mod_selfselectadvanced {{/str}}</h3>
        <ul class="list-group mb-4 selfselectadvanced-mynominations">
            {{#mynominations}}
                <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                    <span>
                        <a href="{{url}}">{{name}}</a>
                        <span class="text-muted small ms-2">{{pluginuid}}</span>
                    </span>
                    <span class="badge bg-warning text-dark">
                        {{#isstepout}}{{#str}} nominationstepoutbadge, mod_selfselectadvanced {{/str}}{{/isstepout}}
                        {{^isstepout}}{{#str}} nominationtransferbadge, mod_selfselectadvanced {{/str}}{{/isstepout}}
                    </span>
                </li>
            {{/mynominations}}
        </ul>
    {{/hasmynominations}}
{{/isstudent}}

{{#showjoinlink}}
    <p><a href="{{joinurl}}" class="btn btn-outline-secondary">{{#str}} joinheading, mod_selfselectadvanced {{/str}}</a></p>
{{/showjoinlink}}

{{#ismanager}}
    <p><a href="{{manageurl}}" class="btn btn-outline-primary">{{#str}} managerdashboard, mod_selfselectadvanced {{/str}}</a></p>
{{/ismanager}}
{{#iscoordinator}}
    <p><a href="{{ticketsurl}}" class="btn btn-outline-primary">{{#str}} coordinatordashboard, mod_selfselectadvanced {{/str}}</a></p>
{{/iscoordinator}}

{{#isstaff}}
    <h3>{{#str}} allgroups, mod_selfselectadvanced {{/str}}</h3>
    {{#hasallgroups}}
        <div class="table-responsive">
            <table class="table generaltable selfselectadvanced-allgroups">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} groupname, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} pluginid, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} worktitle, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} state, mod_selfselectadvanced {{/str}}</th>
                        <th scope="col">{{#str}} size, mod_selfselectadvanced {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#allgroups}}
                        <tr>
                            <td><a href="{{url}}">{{name}}</a></td>
                            <td>{{pluginuid}}</td>
                            <td>{{title}}</td>
                            <td>{{statelabel}}</td>
                            <td>{{seatsummary}}</td>
                        </tr>
                    {{/allgroups}}
                </tbody>
            </table>
        </div>
        {{#allgroupstruncated}}
            <p class="text-muted">
                {{allgroupsshowingtext}}
                {{#canseeallgroups}}
                    <a href="{{manageallurl}}">{{#str}} allgroupsseeall, mod_selfselectadvanced {{/str}}</a>
                {{/canseeallgroups}}
            </p>
        {{/allgroupstruncated}}
    {{/hasallgroups}}
    {{^hasallgroups}}
        <p class="text-muted">{{#str}} nogroupsyet, mod_selfselectadvanced {{/str}}</p>
    {{/hasallgroups}}
{{/isstaff}}
</div>
